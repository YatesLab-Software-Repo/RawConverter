<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Thermo RawFileReader packages are not published on nuget.org. -->
    <add key="ThermoPackages" value="ThermoPkg" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="ThermoPackages">
      <package pattern="ThermoFisher.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
