<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RawConverter.Gui.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <SimpleTheme />

    <!-- Classic Windows Forms look: grey dialog background, 11px text. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="#F0F0F0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#7A7A7A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="CheckBox:disabled, RadioButton:disabled">
      <Setter Property="Foreground" Value="#A0A0A0" />
    </Style>
    <Style Selector="Menu">
      <Setter Property="Background" Value="#F5F5F5" />
    </Style>

    <!-- A WinForms GroupBox: a thin frame with the header drawn over its top edge; the content is
         positioned from the box's top-left corner, as in WinForms. -->
    <Style Selector="HeaderedContentControl.groupbox">
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="3" Margin="0,7,0,0" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
            <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}"
                              Margin="6,0,0,0" Padding="2,0" Background="#F0F0F0"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
