<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RawConverter.Gui.Views.AboutWindow"
        Title="About RawConverter"
        Width="435" Height="282" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- The Yates Lab and Scripps Research logos side by side across the top, the text below them. -->
  <Canvas>
    <Image Canvas.Left="12" Canvas.Top="14" Width="196" Height="90" Source="avares://RawConverterGUI/Assets/yates_logo.png"
           Stretch="Uniform" />
    <Image Canvas.Left="227" Canvas.Top="14" Width="196" Height="90" Source="avares://RawConverterGUI/Assets/logo.png"
           Stretch="Uniform" />
    <TextBlock Canvas.Left="12" Canvas.Top="128" Text="RawConverter" FontWeight="Bold" />
    <TextBlock Name="VersionText" Canvas.Left="12" Canvas.Top="150" />
    <TextBlock Canvas.Left="12" Canvas.Top="172" Text="Copyright © 2026 The Scripps Research Institute" />
    <TextBlock Name="BrukerText" Canvas.Left="12" Canvas.Top="200" TextWrapping="Wrap" Width="411" />
    <Button Canvas.Left="348" Canvas.Top="247" Width="75" Height="23" Content="OK" IsDefault="True" IsCancel="True"
            Click="OnOk" />
  </Canvas>
</Window>
