<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RawConverter.Gui.Views.AboutWindow"
        Title="About RawConverter"
        Width="435" Height="330" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- The Scripps Research logo (wide) across the top, the text below it. -->
  <Canvas>
    <Image Canvas.Left="12" Canvas.Top="16" Width="411" Height="140" Source="avares://RawConverterGUI/Assets/logo.png"
           Stretch="Uniform" />
    <TextBlock Canvas.Left="12" Canvas.Top="176" Text="RawConverter" FontWeight="Bold" />
    <TextBlock Name="VersionText" Canvas.Left="12" Canvas.Top="198" />
    <TextBlock Canvas.Left="12" Canvas.Top="220" Text="Copyright © 2014 The Scripps Research Institute" />
    <TextBlock Name="BrukerText" Canvas.Left="12" Canvas.Top="248" TextWrapping="Wrap" Width="411" />
    <Button Canvas.Left="348" Canvas.Top="295" Width="75" Height="23" Content="OK" IsDefault="True" IsCancel="True"
            Click="OnOk" />
  </Canvas>
</Window>
